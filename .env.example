# À renseigner dans Vercel → Settings → Environment Variables (jamais dans le code).

# Supabase → Connect → "Transaction pooler" (port 6543). Remplace [YOUR-PASSWORD] par le mot de passe de la base.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-eu-west-3.pooler.supabase.com:6543/postgres

# Mot de passe pour ouvrir l'app, et une longue phrase aléatoire (40+ caractères) pour signer la session.
APP_PASSWORD=
SESSION_SECRET=

# Phases suivantes
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# ANTHROPIC_API_KEY=
